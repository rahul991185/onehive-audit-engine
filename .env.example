APP_ENV=development
DATABASE_URL=sqlite:///./storage/onehive.db

# AI Provider Options: deterministic | ollama | gemini | openai
AI_PROVIDER=deterministic

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Google Maps Places API key (system functions via layered resolver if absent)
GOOGLE_MAPS_API_KEY=

# Centralized OneHive Branding & Contact Info
ONEHIVE_WEBSITE=www.onehivetech.com
ONEHIVE_EMAIL=growth@onehivetech.com
ONEHIVE_PHONE=+91 98450 12345
ONEHIVE_ADDRESS=Bengaluru, India
ONEHIVE_QR_URL=https://onehivetech.com/consultation

FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:8050
PORT=8050
HOST=127.0.0.1
